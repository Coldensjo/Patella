<?xml version="1.0" encoding="utf-8"?>
<!--
	Patella.exe: the reconstructed Tibia 7.72 client (issue #16).
	Every src\*.cpp, src\Extern\regexp\*.c and src\res\Patella.rc, x86, static MFC (nafxcw.lib) and
	the static CRT (/MT), no manifest (Tibia.exe has none; notes/resources.md). The system libraries
	are the original's import table (notes/decisions.md, "Building Patella.exe (issue #16)"), with
	oleacc.dll delay-loaded as in Tibia.exe. Output: build\Release\Patella.exe (build\Debug for
	the debug configuration), intermediates in build\obj\<configuration>.
	The resource pictures come from the local Tibia.exe (tools\extract_resources.py writes them to
	build\res; the ExtractResources target runs it when build\res\resources.tsv is missing).
	Command line: tools\build-patella.cmd.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<ItemGroup Label="ProjectConfigurations">
		<ProjectConfiguration Include="Debug|Win32">
			<Configuration>Debug</Configuration>
			<Platform>Win32</Platform>
		</ProjectConfiguration>
		<ProjectConfiguration Include="Release|Win32">
			<Configuration>Release</Configuration>
			<Platform>Win32</Platform>
		</ProjectConfiguration>
	</ItemGroup>
	<PropertyGroup Label="Globals">
		<VCProjectVersion>18.0</VCProjectVersion>
		<ProjectGuid>{6B1D3C2E-4A57-4E0F-9C1B-7A1F2E5D8C16}</ProjectGuid>
		<Keyword>MFCProj</Keyword>
		<RootNamespace>Patella</RootNamespace>
		<WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
		<!-- No vcpkg integration: it would add its include and library paths and link every library it has. -->
		<VcpkgEnabled>false</VcpkgEnabled>
	</PropertyGroup>
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
	<PropertyGroup Label="Configuration">
		<ConfigurationType>Application</ConfigurationType>
		<PlatformToolset>v145</PlatformToolset>
		<UseOfMfc>Static</UseOfMfc>
		<!-- No _MBCS or _UNICODE, as tools\compile-check.cmd: MFC links its ANSI nafxcw.lib. -->
		<CharacterSet>NotSet</CharacterSet>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
		<UseDebugLibraries>true</UseDebugLibraries>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
		<UseDebugLibraries>false</UseDebugLibraries>
		<WholeProgramOptimization>false</WholeProgramOptimization>
	</PropertyGroup>
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
	<PropertyGroup>
		<OutDir>$(MSBuildProjectDirectory)\build\$(Configuration)\</OutDir>
		<IntDir>$(MSBuildProjectDirectory)\build\obj\$(Configuration)\</IntDir>
		<TargetName>Patella</TargetName>
		<GenerateManifest>false</GenerateManifest>
		<EmbedManifest>false</EmbedManifest>
		<LinkIncremental>false</LinkIncremental>
	</PropertyGroup>
	<ItemDefinitionGroup>
		<ClCompile>
			<WarningLevel>Level3</WarningLevel>
			<LanguageStandard>stdcpp17</LanguageStandard>
			<ConformanceMode>true</ConformanceMode>
			<AdditionalOptions>/Zc:strictStrings- %(AdditionalOptions)</AdditionalOptions>
			<ExceptionHandling>Sync</ExceptionHandling>
			<SDLCheck>false</SDLCheck>
			<PrecompiledHeader>NotUsing</PrecompiledHeader>
			<AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
			<PreprocessorDefinitions>WIN32;_WINDOWS;_WIN32_WINNT=0x0601;%(PreprocessorDefinitions)</PreprocessorDefinitions>
			<DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
			<MultiProcessorCompilation>true</MultiProcessorCompilation>
		</ClCompile>
		<ResourceCompile>
			<!-- The pictures extracted from Tibia.exe; MFC's afxres.rc is not included (Patella.rc has MFC 7.1's). -->
			<AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\build\res;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
			<Culture>0x0409</Culture>
		</ResourceCompile>
		<Link>
			<SubSystem>Windows</SubSystem>
			<TargetMachine>MachineX86</TargetMachine>
			<GenerateDebugInformation>true</GenerateDebugInformation>
			<GenerateManifest>false</GenerateManifest>
			<!-- Tibia.exe's import table in its order; Direct3D 9 is loaded at run time (LoadLibrary). -->
			<AdditionalDependencies>glu32.lib;opengl32.lib;ddraw.lib;dxguid.lib;winmm.lib;kernel32.lib;user32.lib;gdi32.lib;winspool.lib;advapi32.lib;shell32.lib;comctl32.lib;shlwapi.lib;oleaut32.lib;ws2_32.lib</AdditionalDependencies>
			<!-- afxsock.h asks for wsock32.lib, which MFC's socket code would then import from: Tibia.exe
				imports every Windows Sockets function from WS2_32.dll (same ordinals). -->
			<IgnoreSpecificDefaultLibraries>wsock32.lib</IgnoreSpecificDefaultLibraries>
			<!-- MSBuild adds delayimp.lib. -->
			<DelayLoadDLLs>oleacc.dll</DelayLoadDLLs>
		</Link>
	</ItemDefinitionGroup>
	<ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
		<ClCompile>
			<Optimization>Disabled</Optimization>
			<RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
			<PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
		<ResourceCompile>
			<PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ResourceCompile>
	</ItemDefinitionGroup>
	<ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
		<ClCompile>
			<Optimization>MaxSpeed</Optimization>
			<RuntimeLibrary>MultiThreaded</RuntimeLibrary>
			<PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
			<FunctionLevelLinking>true</FunctionLevelLinking>
			<IntrinsicFunctions>true</IntrinsicFunctions>
		</ClCompile>
		<ResourceCompile>
			<PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ResourceCompile>
		<Link>
			<EnableCOMDATFolding>true</EnableCOMDATFolding>
			<OptimizeReferences>true</OptimizeReferences>
		</Link>
	</ItemDefinitionGroup>
	<!-- Every source file of the reconstruction; the C files of the regexp compile as C. -->
	<ItemGroup>
		<ClCompile Include="src\*.cpp" />
		<ClCompile Include="src\Extern\regexp\*.c" />
	</ItemGroup>
	<ItemGroup>
		<ClInclude Include="src\*.h" />
		<ClInclude Include="src\Extern\glh\*.h" />
		<ClInclude Include="src\Extern\regexp\*.h" />
		<ClInclude Include="src\res\resource.h" />
	</ItemGroup>
	<ItemGroup>
		<ResourceCompile Include="src\res\Patella.rc" />
	</ItemGroup>
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
	<!-- Writes the cursors, the icon and the bitmaps of the local Tibia.exe to build\res. -->
	<Target Name="ExtractResources" BeforeTargets="ResourceCompile" Condition="!Exists('$(MSBuildProjectDirectory)\build\res\resources.tsv')">
		<Error Condition="!Exists('$(MSBuildProjectDirectory)\Tibia.exe')" Text="Tibia.exe is missing: the resource pictures are extracted from it (notes/resources.md)." />
		<Exec Command="python -I &quot;$(MSBuildProjectDirectory)\tools\extract_resources.py&quot; &quot;$(MSBuildProjectDirectory)\Tibia.exe&quot; &quot;$(MSBuildProjectDirectory)\build\res&quot;" />
	</Target>
</Project>
